{
  "name": "podiss-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend application for the PodIss podcast platform.",
  "homepage": "https://podiss.com.br/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Code-EJ/podiss-frontend.git"
  },
  "license": "SEE LICENSE",
  "author": {
    "name": "Code Soluções em Tecnologia Júnior"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "contributors": [
    "oEnzoRibas"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/test-local-backend.mjs",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
